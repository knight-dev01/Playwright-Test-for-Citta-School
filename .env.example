# Typed sign-in accounts (Docx Sec.2 — all Demo2026! / 123456 unless noted)
APPLICANT_USER=applicant
APPLICANT_PASS=Demo2026!
APPLICANT_CODE=123456

STUDENT_USER=DU/CSC/23/0001
STUDENT_PASS=Demo2026!
STUDENT_CODE=123456

# Adaeze after matriculation — dynamic: matric number from TC-08, temp Welcome2026!
NEW_STUDENT_CODE=123456

LECTURER_USER=lecturer
LECTURER_PASS=Demo2026!
LECTURER_CODE=123456

REGISTRAR_USER=registrar
REGISTRAR_PASS=Demo2026!
